! Light mode (the original look). Applied by theme-mode; Super+Shift+T toggles light/dark.
*background:  #ffffff
*foreground:  #000000
*cursorColor: #000000
*color0:  #000000
*color8:  #000000
*color1:  #bd000d
*color9:  #bd000d
*color2:  #006607
*color10: #006607
*color3:  #ffbb00
*color11: #ffbb00
*color4:  #004ce6
*color12: #004ce6
*color5:  #ad007f
*color13: #ad007f
*color6:  #005a61
*color14: #005a61
*color7:  #aaaaaa
*color15: #ffffff
! i3 bar and focused window title
i3wm.barBg:   #ffffff
i3wm.barFg:   #000000
i3wm.barDim:  #aaaaaa
i3wm.focusBg: #000000
i3wm.focusFg: #ffffff
